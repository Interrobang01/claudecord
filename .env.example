# Required: Discord bot token
DISCORD_TOKEN=your-discord-bot-token-here

# Optional: Discord guild (server) ID for instant slash command registration.
# Without this, global commands can take up to 1 hour to propagate.
GUILD_ID=

# Optional: default working directory for Claude Code (defaults to process.cwd())
DEFAULT_CWD=/path/to/your/working/directory

# Optional: path to the claude binary (defaults to `claude` on PATH)
CLAUDE_BIN=claude

# Optional: directory holding skill markdown files for /install-skill
# (e.g. an Obsidian vault's Skills/ folder). Defaults to ~/obsidian-vault/Skills.
# VAULT_SKILLS_DIR=/path/to/your/skills/source

# If you use 1Password CLI, you can replace any of the above with op:// refs
# and run `npm run start:op` instead of `npm start`. Example:
# DISCORD_TOKEN=op://Vault/Discord Bot/credential

# Optional: the literal a turn can emit to decline to post anything at all.
# Defaults to NO_RESPONSE. Matched against the start of the final message.
# SILENT_TOKEN=NO_RESPONSE
